// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth Models (NextAuth.js) ──────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id                String      @id @default(cuid())
  name              String?
  email             String?     @unique
  emailVerified     DateTime?
  image             String?
  passwordHash      String?
  passwordChangedAt DateTime?
  loginAttempts     Int         @default(0)
  lockoutUntil      DateTime?
  role              Role        @default(USER)
  status            UserStatus  @default(ACTIVE)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  accounts Account[]
  sessions Session[]
  articles Article[]
  watchedCompanies WatchedCompany[]
  auditLogs AuditLog[]
  pipelineDiscoverySessions PipelineDiscoverySession[]
  deepAgentSessions DeepAgentSession[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Domain Models ──────────────────────────────────────────────────────────

enum SourceType {
  NEWS
  FILING
  TRANSCRIPT
  SOCIAL
  BLOG
  JOB_POSTING
  RSS
  PATENT
  LITIGATION
  FDA
  CONTRACT
  TECH_SIGNAL
  WEB_ARCHIVE
  LEGISLATION
  ACADEMIC
  PODCAST
  CONFERENCE
  PRESS_RELEASE
  LOBBYING
}

enum ThemeStatus {
  EMERGING
  ACCELERATING
  PEAKED
  FADING
  RESOLVED
}

enum InferenceStatus {
  EMERGING
  DEVELOPING
  CONFIRMED
  REFUTED
  RESOLVED
}

enum HypothesisStatus {
  ACTIVE
  ARCHIVED
  CONFIRMED
  REFUTED
}

enum DebateStatus {
  ACTIVE
  RESOLVED
  STALE
}

enum SignalStatus {
  PENDING
  ANALYZING
  ANALYZED
  FAILED
  LOW_QUALITY
  NON_ENGLISH
  REJECTED
}

enum Sentiment {
  POSITIVE
  NEGATIVE
  NEUTRAL
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  PENDING_REVIEW
}

enum AgentPersona {
  ANALYST
  GOSSIP_GIRL
}

enum DataOrigin {
  SCRAPED
  BOOTSTRAP
  SEED
  MANUAL
}

model Company {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  ticker      String?
  description String?  @db.Text
  websiteUrl  String?
  industry    String?
  sector      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  signals           Signal[]
  articles          Article[]
  watchedBy         WatchedCompany[]
  pipelineRuns      PipelineRun[]
  inferences        Inference[]
  signalThemes      SignalTheme[]
  hypotheses        CompanyHypothesis[]
  trackedSubreddits TrackedSubreddit[]
  dataSources       CompanyDataSource[]
  enrichmentLogs    CompanyEnrichmentLog[]
  clusterArticles   ClusterArticle[]
  alerts            SignalAlert[]
}

model CompanyHypothesis {
  id          String             @id @default(cuid())
  companyId   String
  title       String
  description String             @db.Text
  status      HypothesisStatus   @default(ACTIVE)
  confidence  Float              @default(0.5)
  evidence    Json               @default("[]")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@index([confidence])
}

model Signal {
  id            String       @id @default(cuid())
  sourceUrl     String
  sourceType    SourceType
  title         String
  rawContent    String       @db.Text
  contentHash   String?      @unique
  publishedAt   DateTime?
  scrapedAt     DateTime     @default(now())
  
  // Provenance fields
  scraperName       String?
  verified          Boolean     @default(false)
  scrapeAttempts    Int?
  rawContentHash    String?
  feedLabel         String?
  dataOrigin        DataOrigin  @default(SCRAPED)
  
  companyId     String
  status        SignalStatus @default(PENDING)
  embedding     Unsupported("vector(384)")?
  engagement    Json?
  author        String?
  metadata      Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  analyses  Analysis[]
  debates   AgentDebate[]
  themes    SignalTheme[]
  alerts    SignalAlert[]
  clusterId String?
  cluster   SignalTheme? @relation("SignalCluster", fields: [clusterId], references: [id])
  contradictions Json?

  @@index([companyId])
  @@index([sourceType])
  @@index([status])
  @@index([scrapedAt])
  @@index([contentHash])
  @@index([sourceUrl])
  @@index([clusterId])
  @@index([companyId, createdAt])
  @@index([companyId, clusterId])
}

model Analysis {
  id                String       @id @default(cuid())
  signalId          String
  agentPersona      AgentPersona
  summary           String       @db.Text
  keyFacts          Json
  sentiment         Sentiment
  sentimentData     Json?
  strategicThemes   Json
  confidence        Float
  modelUsed         String
  crossReferences   Json?
  analyzedAt        DateTime     @default(now())
  // True if agent's sourcePreferences matched signal sourceType
  sourceMatchPreference Boolean?

  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@unique([signalId, agentPersona])
  @@index([signalId])
  @@index([sentiment])
  @@index([analyzedAt])
  @@index([agentPersona])
}

model AgentDebate {
  id                  String   @id @default(cuid())
  signalId            String
  clusterId           String?
  analystPosition     Json
  gossipGirlPosition  Json
  pointsOfAgreement   Json
  pointsOfContention  Json
  synthesis           String   @db.Text
  generatedAt         DateTime @default(now())

  signal  Signal       @relation(fields: [signalId], references: [id], onDelete: Cascade)
  cluster SignalTheme? @relation("ClusterDebate", fields: [clusterId], references: [id], onDelete: SetNull)

  @@index([signalId])
  @@index([clusterId])
  @@index([generatedAt])
}

// ─── Cross-Signal Correlation ──────────────────────────────────────────────

model SignalTheme {
  id              String      @id @default(cuid())
  companyId       String
  label           String
  description     String?     @db.Text
  status          ThemeStatus @default(EMERGING)
  momentum        Float       @default(0)
  firstSeen       DateTime    @default(now())
  lastUpdated     DateTime    @updatedAt
  embedding       Json?
  clusterSummary  Json?
  lastAnalyzedAt  DateTime?

  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  signals           Signal[]
  clusteredSignals  Signal[]          @relation("SignalCluster")
  inferences        Inference[]
  clusterArticles   ClusterArticle[]
  clusterDebates    AgentDebate[]     @relation("ClusterDebate")

  @@index([companyId])
  @@index([status])
  @@index([momentum])
  @@index([companyId, status])
  @@index([companyId, momentum])
}

model Inference {
  id                       String           @id @default(cuid())
  companyId                String
  themeId                  String?
  title                    String
  hypothesis               String           @db.Text
  confidence               Float
  supportingSignalIds      Json             @default("[]")
  contradictingSignalIds   Json             @default("[]")
  sourceTypesInvolved      Json             @default("[]")
  status                   InferenceStatus  @default(EMERGING)
  predictedOutcome         String?          @db.Text
  resolvedAt               DateTime?
  wasCorrect               Boolean?
  agentAnalyses            Json?
  debateId                 String?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  theme    SignalTheme?  @relation(fields: [themeId], references: [id], onDelete: SetNull)
  articles Article[]
  calibrations InferenceCalibration[]
  debate   CrossSignalDebate? @relation("InferenceDebate")

  @@index([companyId])
  @@index([status])
  @@index([confidence])
}

model InferenceCalibration {
  id                String    @id @default(cuid())
  inferenceId       String
  prediction        String    @db.Text
  predictedAt       DateTime  @default(now())
  resolvedAt        DateTime?
  wasCorrect        Boolean?
  sourceReliability Float     @default(0.5)
  notes             String?   @db.Text

  inference Inference @relation(fields: [inferenceId], references: [id], onDelete: Cascade)

  @@index([inferenceId])
  @@index([predictedAt])
}

model CrossSignalDebate {
  id                  String         @id @default(cuid())
  inferenceId         String         @unique
  debateTranscript    String         @db.Text
  consensusReached    Boolean        @default(false)
  finalConfidence     Float?
  status              DebateStatus   @default(ACTIVE)
  analystClaim        String         @default("") @db.Text
  analystEvidence     Json           @default("[]")
  analystConfidence   Float          @default(0.5)
  gossipClaim         String         @default("") @db.Text
  gossipEvidence      Json           @default("[]")
  gossipTellStrength  Float          @default(0.5)
  agreements          Json           @default("[]")
  contentions         Json           @default("[]")
  synthesisText       String         @default("") @db.Text
  evidenceProvenance  Json?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  inference Inference @relation("InferenceDebate", fields: [inferenceId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
}

model Article {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  summary       String        @db.Text
  body          String        @db.Text
  companyId     String
  agentPersona  AgentPersona
  analysisIds   Json          @default("[]")
  inferenceId   String?
  publishedAt   DateTime?
  status        ArticleStatus @default(DRAFT)
  authorId      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author    User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  inference Inference?   @relation(fields: [inferenceId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([status])
  @@index([publishedAt])
  @@index([agentPersona])
}

model ClusterArticle {
  id            String        @id @default(cuid())
  themeId       String
  theme         SignalTheme   @relation(fields: [themeId], references: [id], onDelete: Cascade)
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title         String
  slug          String        @unique
  summary       String        @db.Text
  body          String        @db.Text
  agentPersona  AgentPersona
  signalCount   Int           @default(0)
  status        ArticleStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([themeId, agentPersona])
  @@index([companyId, status])
}

model WatchedCompany {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
}

model SignalAlert {
  id                  String      @id @default(cuid())
  signalId            String
  companyId           String
  alertType           String
  analystConfidence   Float
  gossipTellStrength  Float
  message             String
  status              String      @default("PENDING")
  createdAt           DateTime    @default(now())
  readAt              DateTime?

  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([signalId])
  @@index([companyId])
  @@index([status])
  @@index([createdAt])
}

// ─── Scraping Cache ─────────────────────────────────────────────────────────

model ScrapeCache {
  id        String   @id @default(cuid())
  url       String   @unique
  content   String   @db.Text
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// ─── Admin & Audit ──────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([resource])
}

// ─── System Configuration ────────────────────────────────────────────────────

model SystemConfig {
  id                              String   @id @default(cuid())
  discoverySchedule               String   @default("0 */6 * * *")
  discoveryEnabled                Boolean  @default(true)
  defaultAiProvider               String   @default("openai")
  analystModel                    String   @default("qwen3-coder-next")
  gossipGirlModel                 String   @default("qwen3-coder-next")
  minConfidenceForPublication     Float    @default(0.7)
  minQualityScore                 Float    @default(0.6)
  semanticDeduplication           Boolean  @default(true)
  languageDetection               Boolean  @default(true)
  qualityGate                     Boolean  @default(true)
  requestsPerMinute               Int      @default(60)
  burstLimit                      Int      @default(100)
  emailConfigured                 Boolean  @default(false)
  emailFrom                       String?
  emailSmtpHost                   String?
  emailSmtpPort                   Int?
  correlationWindowSize           Int      @default(30)
  minSignalsForCorrelation        Int      @default(3)
  correlationConfidenceThreshold  Float    @default(0.6)
  clusterRoutingEnabled           Boolean  @default(false)
  clusterMatchThreshold           Float    @default(0.75)
  clusterArticleAutoRegenerate    Boolean  @default(true)
  clusterArticleRegenThresholds   Json     @default("[3,5,10,20]")
  clusterAnalysisModel            String   @default("qwen3-coder-next")
  updatedAt                       DateTime @updatedAt
}

model ModerationSettings {
  id                              String   @id @default(cuid())
  enabled                         Boolean  @default(false)
  autoApproveConfidenceThreshold  Float?
  autoApproveSources              Json?
  notificationEmail               String?
  notifyOnNewContent              Boolean  @default(false)
  updatedAt                       DateTime @updatedAt

  @@index([enabled])
}

// ─── Data Collection Pipelines ──────────────────────────────────────────────

model PipelineRun {
  id                String     @id @default(cuid())
  companyId         String
  scraperName       String
  sourceType        SourceType
  status            String     // "pending", "running", "completed", "failed", "skipped"
  signalsCreated    Int        @default(0)
  duplicatesSkipped Int        @default(0)
  error             String?    @db.Text
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime   @default(now())

  company           Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  logs              PipelineLog[]

  @@index([companyId])
  @@index([scraperName])
  @@index([status])
  @@index([createdAt])
}

model PipelineLog {
  id        String   @id @default(cuid())
  runId     String
  level     String   @default("info")
  message   String
  details   Json?
  createdAt DateTime @default(now())

  run       PipelineRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([createdAt])
}

model TrackedSubreddit {
  id              String    @id @default(cuid())
  companyId       String
  subreddit       String
  reason          String?   @db.Text
  subscriberCount Int?
  isActive        Boolean   @default(true)
  discoveredAt    DateTime  @default(now())
  lastValidatedAt DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, subreddit])
  @@index([companyId])
  @@index([subreddit])
  @@index([isActive])
}

model SubredditDiscoveryLog {
  id              String    @id @default(cuid())
  companyId       String
  status          String
  suggestedCount  Int       @default(0)
  validatedCount  Int       @default(0)
  error           String?   @db.Text
  llmModel        String?
  durationMs      Int?
  createdAt       DateTime  @default(now())

  @@index([companyId])
  @@index([createdAt])
}

// ─── Company Enrichment Pipeline ────────────────────────────────────────────

model CompanyDataSource {
  id                  String     @id @default(cuid())
  companyId           String
  url                 String
  sourceType          SourceType
  label               String?
  discoveryMethod     String     // "website-probe", "pipeline-orchestrator", "enrichment", "manual", "seed"
  isActive            Boolean    @default(true)
  validatedAt         DateTime?
  lastCheckedAt       DateTime?
  lastSuccessAt       DateTime?
  consecutiveFailures Int        @default(0)
  httpStatusCode      Int?
  failureReason       String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  company             Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, url])
  @@index([companyId])
  @@index([sourceType])
}

model CompanyEnrichmentLog {
  id                String   @id @default(cuid())
  companyId         String
  status            String   // "success", "partial", "failed"
  feedsDiscovered   Int      @default(0)
  feedsValidated    Int      @default(0)
  tickerFound       String?
  socialsDiscovered Int      @default(0)
  blogsDiscovered   Int      @default(0)
  error             String?  @db.Text
  durationMs        Int
  createdAt         DateTime @default(now())

  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ─── Pipeline Discovery Orchestrator ────────────────────────────────────────

model PipelineDiscoverySession {
  id          String   @id @default(cuid())
  sessionId   String   @unique // For SSE stream tracking
  userId      String
  companyName String
  companyId   String?
  status      String   @default("running") // running, completed, failed, cancelled
  startedAt   DateTime @default(now())
  completedAt DateTime?
  eventLog    Json?    // Full event history for replay
  error       String?

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  discoveredSources DiscoveredSource[]

  @@index([userId])
  @@index([status])
  @@index([sessionId])
}

model DiscoveredSource {
  id                  String                 @id @default(cuid())
  sessionId           String
  url                 String
  sourceType          SourceType
  label               String?
  priority            Int                    @default(5)
  verified            Boolean                @default(false)
  verificationDetails String?
  createdAt           DateTime               @default(now())

  session             PipelineDiscoverySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// ─── DeepAgent Chat ─────────────────────────────────────────────────────────

model DeepAgentSession {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New Chat")
  status    String   @default("idle") // idle, running, completed, failed
  model     String?  // Model used for this session (e.g. "qwen3-coder-next", "MiniMax-M2.5")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  DeepAgentMessage[]
  approvals DeepAgentApproval[]
  shares    DeepAgentShare[]

  @@index([userId])
  @@index([status])
  @@index([updatedAt])
}

model DeepAgentMessage {
  id           String   @id @default(cuid())
  sessionId    String
  role         String   // user, assistant, system, tool
  content      String   @default("") @db.Text
  toolCalls    Json?    // Array of { id, name, input, output, status, duration }
  fileChanges  Json?    // Array of { path, type, additions, deletions, diff }
  tokenUsage   Json?    // { inputTokens: number, outputTokens: number, totalTokens: number, cachedTokens?: number }
  isStreaming  Boolean  @default(false)
  timestamp    DateTime @default(now())

  session DeepAgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([timestamp])
  @@index([role])
}

model DeepAgentApproval {
  id          String    @id @default(cuid())
  sessionId   String
  toolName    String
  toolInput   Json
  status      String    @default("pending") // pending, approved, rejected, timeout
  decidedBy   String?   // userId who decided
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  session DeepAgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([status])
  @@index([createdAt])
}

model DeepAgentShare {
  id          String    @id @default(cuid())
  sessionId   String
  token       String    @unique
  expiresAt   DateTime
  createdBy   String
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  session DeepAgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([sessionId])
  @@index([expiresAt])
}
