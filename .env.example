# Database
DATABASE_URL=postgresql://thell_user:thell_password@localhost:5433/the_tell

# NextAuth
NEXTAUTH_SECRET=change-me-to-a-random-string
NEXTAUTH_URL=http://localhost:3000

# LLM Configuration (OpenAI-compatible API)
# Required for AI analysis, inference generation, and article creation
API_KEY=your-api-key-here
BASE_URL=https://your-api-endpoint.com/v1
FAST_MODEL=your-fast-model-name
REASONING_MODEL=your-reasoning-model-name
VISION_MODEL=your-vision-model-name

# Optional: Anthropic provider (if using Claude models)
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Optional: Override model for deepagent system
# DEEPAGENT_MODEL=your-deepagent-model

# Inngest (local dev)
# Set INNGEST_DEV=1 for local dev server (Docker or CLI)
# Set INNGEST_SIGNING_KEY for production (Inngest Cloud)
INNGEST_DEV=1
INNGEST_SIGNING_KEY=

# Inngest (production)
# INNGEST_EVENT_KEY=your-event-key-here
# INNGEST_BASE_URL=https://api.inngest.com

# Admin Configuration (optional, for API key authentication)
ADMIN_API_KEY=

# Scraper API Keys
# These keys are used by scrapers for company intelligence gathering.
# All optional — features degrade gracefully without keys.

# USPTO PatentsView API key (optional) — patent & trademark search via MCP
USPTO_API_KEY=

# CourtListener API key (optional) — litigation records via MCP
COURT_LISTENER_API_KEY=

# Optional: unlimited JobDataLake MCP access (default free tier: 500 calls/day without key)
JDL_API_KEY=

SAM_API_KEY=
CONGRESS_API_KEY=

# GitHub API token (optional) — increases rate limit from 10 to 30 requests/minute for MCP server
GITHUB_TOKEN=

# Web Search — Brave Search API (required for pipeline orchestrator company discovery)
# Also used for dynamic URL discovery in the scraping pipeline.
# Free tier: ~1,000 queries/month ($5 credit). Falls back to DuckDuckGo if not set.
BRAVE_API_KEY=

# NLP GPU Acceleration
# Options: auto (default), cuda, dml, webgpu, cpu
# cuda: NVIDIA GPU on Linux x64 only
# dml: DirectML for Windows GPU (NVIDIA, AMD, Intel)
# webgpu: WebGPU (browser or Node.js 23+ with --experimental-webgpu)
# cpu: CPU-only inference
NLP_DEVICE=auto

# Stealth Browser (CloakBrowser CDP)
CLOAKBROWSER_CDP_URL=ws://localhost:9222
STEALTH_SCRAPER_ENABLED=true

# RSSHub (self-hosted Twitter/X scraping)
# RSSHub generates RSS feeds from Twitter timelines without requiring API keys
# Run via Docker: docker compose up -d rsshub
RSSHUB_URL=http://localhost:1200

# Langfuse (LLM Observability)
# Self-hosted at http://localhost:3001 — get keys from Settings > API Keys after first login
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3001
LANGFUSE_ENABLED=false
