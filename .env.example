# Database
DATABASE_URL=postgresql://thetell_user:thetell_password@localhost:5433/the_tell

# NextAuth
NEXTAUTH_SECRET=change-me-to-a-random-string
NEXTAUTH_URL=http://localhost:3000

# LLM Providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Inngest (local dev)
# Set INNGEST_DEV=1 for local dev server (Docker or CLI)
# Set INNGEST_SIGNING_KEY for production (Inngest Cloud)
INNGEST_DEV=1
INNGEST_SIGNING_KEY=

# Admin Configuration (optional, for API key authentication)
ADMIN_API_KEY=

# Scraper API Keys (all optional - scrapers gracefully degrade without keys)
USPTO_API_KEY=
COURT_LISTENER_API_KEY=
SAM_API_KEY=
CONGRESS_API_KEY=
GITHUB_TOKEN=

# Web Search (Brave Search API) - for dynamic URL discovery
# Free tier: ~1,000 queries/month ($5 credit). Falls back to DuckDuckGo if not set.
BRAVE_API_KEY=

# OpenCode Debug Agent
OPENCODE_URL=http://localhost:4096
OPENCODE_PASSWORD=debug-agent-secret
