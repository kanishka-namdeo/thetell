## addConditionalEdges() Patterns

### Basic Routing

```typescript
import { StateGraph } from "@langchain/langgraph";

function routeByConfidence(state: SignalAnalysisState): string {
  if (state.error) {
    return "deadLetter";
  }
  if (state.confidenceScore >= 0.8) {
    return "publish";
  }
  return "review";
}

const graph = new StateGraph<SignalAnalysisState>({
  channels: { /* ... */ },
});

graph.addConditionalEdges(
  "scoreConfidence",
  routeByConfidence,
  {
    publish: "generateSummary",
    review: "analystReview",
    deadLetter: "failedAnalysis",
  }
);
```

### Tool Loop Routing

```typescript
import { AIMessage } from "@langchain/core/messages";

function shouldCallTools(state: SignalAnalysisState): string {
  const last = state.messages[state.messages.length - 1];
  if (last instanceof AIMessage && last.tool_calls?.length > 0) {
    return "tools";
  }
  return "end";
}

graph.addConditionalEdges("model", shouldCallTools, {
  tools: "tools",
  end: END,
});
graph.addEdge("tools", "model"); // loop back
```

### Max Iteration Guard

```typescript
function shouldContinue(state: InferenceState): string {
  if (state.iteration >= MAX_ITERATIONS) {
    return "finalize";
  }
  return "detectPatterns";
}

graph.addConditionalEdges("refine", shouldContinue);
```

### Routing Rules

| Rule | Detail |
|------|--------|
| Pure functions only | No mutation, no side effects, no LLM calls |
| Return string keys | Must match a key in the path map (or be the node name if no map) |
| Always handle errors | Check `state.error` before other conditions |
| Log routing decisions | Use `logger.debug()` for routing trace |

