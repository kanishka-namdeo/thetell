## Streaming

```typescript
// Token-level streaming (for WebSocket/SSE to frontend)
const stream = await graph.streamEvents(inputData, {
  configurable: { threadId: "analysis-abc-123" },
  version: "v2",
});

for await (const event of stream) {
  if (event.event === "on_chat_model_stream") {
    const token = event.data.chunk.content;
    websocket.send(JSON.stringify({ type: "token", content: token }));
  }
}

// Node-level streaming (intermediate results)
const nodeStream = await graph.stream(inputData, {
  configurable: { threadId: "analysis-abc-123" },
});

for await (const [nodeName, nodeOutput] of nodeStream) {
  websocket.send(JSON.stringify({
    type: "node_output",
    node: nodeName,
    data: nodeOutput,
  }));
}
```

