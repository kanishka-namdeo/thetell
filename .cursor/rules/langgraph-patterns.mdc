## Checkpointing

Use `PostgresSaver` for crash recovery. Reuses the existing `DATABASE_URL`.

```typescript
// src/lib/agent/checkpointer.ts
import { PostgresSaver } from "@langchain/langgraph/checkpoint/postgres";
import { DATABASE_URL } from "@/lib/config";

export async function getCheckpointer(): Promise<PostgresSaver> {
  return PostgresSaver.fromConnString(DATABASE_URL);
}
```

```typescript
// src/lib/agent/graph.ts
import { StateGraph } from "@langchain/langgraph";
import { getCheckpointer } from "./checkpointer";

export async function buildGraph() {
  const checkpointer = await getCheckpointer();
  
  const graph = new StateGraph<SignalAnalysisState>({
    channels: {
      // ... state schema
    },
  });
  
  // ... add nodes and edges
  
  return graph.compile({ checkpointer });
}
```

```typescript
// Invoke with thread_id for isolation
const result = await graph.invoke(
  {
    signalId: "abc-123",
    rawText: "...",
    companyId: "co-456",
  },
  {
    configurable: { threadId: "analysis-abc-123" },
  }
);
```

### Crash Recovery

```typescript
// Resume from last checkpoint
const result = await graph.invoke(null, {
  configurable: { threadId: "analysis-abc-123" },
});

// Time-travel: list checkpoints
const history = await graph.getStateHistory({
  configurable: { threadId: "analysis-abc-123" },
});
```
