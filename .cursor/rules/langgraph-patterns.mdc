## Tool Loop Pattern

LLM tool calls MUST NOT be hidden inside model nodes. The tool execution loop must be explicit in the graph structure using `tool()` + `ToolNode`.

### Required Components

Every tool-enabled step needs **3 parts**:

1. **`tool()` functions** — decorated with `tool()` from `@langchain/core/tools`
2. **Model node** — LLM call with `bindTools(tools)`
3. **`ToolNode`** — from `@langchain/langgraph/prebuilt`, executes tool calls automatically

### Tool-Loop Guard (Mandatory)

Every tool-loop state MUST include an iteration counter. Exit the loop after max iterations.

```typescript
// src/lib/agent/tools/search.ts
import { tool } from "@langchain/core/tools";
import { z } from "zod";
import { prisma } from "@/lib/db";

export const searchSignals = tool(
  async (input) => {
    const signals = await prisma.signal.findMany({
      where: {
        OR: [
          { title: { contains: input.query, mode: "insensitive" } },
          { rawContent: { contains: input.query, mode: "insensitive" } },
        ],
      },
      take: 10,
    });
    return JSON.stringify(signals);
  },
  {
    name: "searchSignals",
    description: "Search for relevant signals by keyword",
    schema: z.object({ query: z.string() }),
  }
);
```

```typescript
// src/lib/agent/nodes/model-node.ts
import { ToolNode } from "@langchain/langgraph/prebuilt";
import { ChatOpenAI } from "@langchain/openai";
import { searchSignals } from "../tools/search";

const tools = [searchSignals];
const llm = new ChatOpenAI({ model: "gpt-4o" }).bindTools(tools);

export async function modelNode(
  state: ToolAgentState
): Promise<Partial<ToolAgentState>> {
  if (state.toolIterations >= MAX_TOOL_ITERATIONS) {
    return {
      messages: [{ role: "assistant", content: "Max tool iterations reached." }],
    };
  }
  
  const response = await llm.invoke(state.messages);
  return {
    messages: [response],
    toolIterations: state.toolIterations + 1,
  };
}

export const toolNode = new ToolNode(tools);
```

```typescript
// src/lib/agent/routing.ts
export function shouldContinue(state: ToolAgentState): string {
  const last = state.messages[state.messages.length - 1];
  
  if (state.toolIterations >= MAX_TOOL_ITERATIONS) {
    return "end";
  }
  if (last.tool_calls && last.tool_calls.length > 0) {
    return "tools";
  }
  return "end";
}
```

