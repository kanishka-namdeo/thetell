## Interrupts & Human-in-the-Loop

Use `interrupt()` from `@langchain/langgraph` to pause for analyst review before publishing high-impact inferences.

```typescript
// src/lib/agent/nodes/analyst-review.ts
import { interrupt } from "@langchain/langgraph";

export async function analystReview(
  state: SignalAnalysisState
): Promise<Partial<SignalAnalysisState>> {
  const decision = await interrupt({
    signalId: state.signalId,
    summary: state.summary || "",
    confidence: state.confidenceScore,
    action: "approve or reject this inference",
  });
  
  if (decision === "approve") {
    return { messages: [{ role: "human", content: "Approved" }] };
  }
  return { error: "Rejected by analyst" };
}
```

### Interrupt Guards

Skip the interrupt if a prior node already advanced the workflow:

```typescript
export async function reviewGate(
  state: SignalAnalysisState
): Promise<Partial<SignalAnalysisState>> {
  if (state.autoApproved) {
    return {};
  }
  
  const decision = await interrupt({ action: "approve or reject" });
  return { approved: decision === "approve" };
}
```

